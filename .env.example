# 공용 레거시 예시입니다. 새 설치에서는 .env.local.example 또는
# .env.prod.example을 각각 .env.local / .env.prod로 복사해 사용하세요.
APP_NAME=Domain RAG MVP (Local)
APP_ENV=local

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=domain_docs

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass

REDIS_HOST=redis
REDIS_PORT=6379

EMBEDDING_MODEL=hashing-384
EMBEDDING_DIM=384

VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY

UPLOAD_DIR=/app/data/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4

# Optional: remote QuantConnect LEAN runner for the backtest workflow.
# 로컬에서는 비워 두고, AWS에서는 .env.prod에 서버 내부 주소와 PEM 경로를 설정합니다.
LEAN_RUNNER=auto
LEAN_LOCAL_WORKDIR_HOST=
LEAN_SSH_HOST=
LEAN_SSH_USER=ubuntu
LEAN_SSH_KEY_HOST_PATH=
LEAN_SSH_KEY_PATH=/run/secrets/lean.pem
LEAN_REMOTE_WORKDIR=/home/ubuntu/lean-workflows
LEAN_DOCKER_IMAGE=quantconnect/lean:latest
