# Personal computer: docker-compose.yml
APP_NAME=Domain RAG MVP (Local)
APP_ENV=local

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=domain_docs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-this-local-password
REDIS_HOST=redis
REDIS_PORT=6379

EMBEDDING_MODEL=hashing-384
EMBEDDING_DIM=384
VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY
UPLOAD_DIR=/app/data/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4

# Leave blank to disable the LEAN workflow locally.
# To use the AWS LEAN runner from this computer, set the public host and your local PEM path.
LEAN_SSH_HOST=
LEAN_SSH_USER=ubuntu
LEAN_SSH_KEY_HOST_PATH=
LEAN_SSH_KEY_PATH=/run/secrets/lean.pem
LEAN_REMOTE_WORKDIR=/home/ubuntu/lean-workflows
LEAN_DOCKER_IMAGE=quantconnect/lean:latest
LEAN_TIMEOUT_SECONDS=300
